# Sample environment configuration
# Copy to .env and fill in your values

# Environment: "development" (default) | "production" | "staging"
# When set to production/staging, missing JWT_SECRET_KEY or APP_ENCRYPTION_KEY
# will hard-fail at startup instead of using insecure dev fallbacks.
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# REQUIRED in production for encrypting tenant SuSoft passwords at rest.
# Generate the same way as JWT_SECRET_KEY (separate key recommended).
APP_ENCRYPTION_KEY=

# JWT token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: comma-separated allowed origins for production frontend(s).
# Leave blank in dev to allow localhost on any port.
CORS_ALLOW_ORIGINS=

# Logging
LOG_LEVEL=INFO
LOG_JSON=0           # set to 1 in prod for structured JSON logs

# Rate limiting
# Set to a redis:// URL when running with multiple workers.
# Leave blank for single-process in-memory limiter.
RATE_LIMIT_REDIS_URL=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lampeland_bakeri

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# SuSoft POS API (REST API v3.1)
# API documentation: https://api.susoft.com:4443/swagger-ui.html
SUSOFT_BASE_URL=https://api.susoft.com:4443
SUSOFT_USERNAME=your_susoft_username
SUSOFT_PASSWORD=your_susoft_password
SUSOFT_SHOP_URL_KEY=your_shop_url_key
SUSOFT_TIMEOUT=30

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Email/SMTP for alerts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@lampeland-bakeri.no

# Application settings
ORDER_CUTOFF_HOUR=15
DEFAULT_ORDER_LEAD_DAYS=14
